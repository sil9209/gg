 const fresh=!prev||prev.screen!==next.screen,tabChanged=prev&&prev.tab!==next.tab,old=prev?.game,now=next.game,dayChanged=old&&now&&old.day!==now.day,phaseChanged=old&&now&&(old.phase!==now.phase||old.secret!==now.secret),changed=fresh||tabChanged||dayChanged||phaseChanged;
 if(fresh){dsAnimate(app.querySelector('.title-inner,.setup,.endwrap'),[{opacity:.65,transform:'translateY(6px)'},{opacity:1,transform:'translateY(0)'}],320);if(screen==='title')dsAll('.title-menu button',[{opacity:.4,transform:'translateY(5px)'},{opacity:1,transform:'translateY(0)'}],260);}
 if(screen==='game'&&changed){dsAnimate(app.querySelector('main .hero img'),[{opacity:.68},{opacity:1}],390);dsAnimate(app.querySelector('main .event-head,main .subhead'),[{opacity:.65},{opacity:1}],270);dsAnimate(app.querySelector('main h1'),[{opacity:.65,transform:'translateX(-4px)'},{opacity:1,transform:'translateX(0)'}],270);dsAll('main .choices > button,main .grid > .tile,main .party-row,main .inventory > .slot,main .log',[{opacity:.65,transform:'translateY(4px)'},{opacity:1,transform:'translateY(0)'}],240,7);}
 if(dayChanged)dsAnimate(app.querySelector('.day'),[{backgroundColor:'#bd7354'},{backgroundColor:'#762e2c'}],550);
 if(now&&screen==='game'){
  app.querySelectorAll('.hud').forEach(h=>[...h.querySelectorAll('.stat')].forEach((row,i)=>{let v=now.stats[i];if(i===0&&v<=25||i===1&&v<=20||i===2&&v<=20||i===3&&v<=20||i===4&&v>=80||i===5&&v>=65)row.classList.add('ds-critical');if(old&&old.stats[i]!==v&&!fresh){let bar=row.querySelector('.track i');dsAnimate(bar,[{width:old.stats[i]+'%'},{width:v+'%'}],460);dsAnimate(row.querySelector('strong'),[{color:'#f7d9a4'},{color:'inherit'}],500);}}));
  if(old&&!fresh){app.querySelectorAll('.mobilehud .res,aside .res').forEach((el,i)=>{let k=i%5+6;if(now.stats[k]!==old.stats[k])dsAnimate(el,[{boxShadow:'inset 0 0 0 1px '+(now.stats[k]>old.stats[k]?'#9eaf86':'#b64f45')},{boxShadow:'inset 0 0 0 1px transparent'}],620)});
   if(now.stats[0]<old.stats[0])dsAnimate(app.querySelector('main .hero'),[{boxShadow:'inset 0 0 0 2px #a64a45,0 0 14px #a64a4544',transform:'translateX(-2px)'},{transform:'translateX(2px)'},{boxShadow:'none',transform:'translateX(0)'}],240);
   if(now.L>old.L){dsAnimate(app.querySelector('.base-mini'),[{filter:'brightness(1.35)'},{filter:'brightness(1)'}],700);dsAnimate(app.querySelector('main .notice'),[{borderColor:'#e3c48b'},{borderColor:'#a98b5c'}],600);}
   if(now.party!==old.party||now.itemCount>old.itemCount||phaseChanged||now.last!==old.last||now.searches!==old.searches){dsAnimate(app.querySelector('main .notice'),[{opacity:.6,transform:'translateY(3px)'},{opacity:1,transform:'translateY(0)'}],320);dsAll('main .notice .chip',[{opacity:.45,transform:'translateY(3px)'},{opacity:1,transform:'translateY(0)'}],280,6);}
  }
 }
 if(screen==='bag'||tab==='bag'&&screen==='game')if(prev?.selectedItem!==next.selectedItem)dsAnimate(app.querySelector('.slot.selected'),[{boxShadow:'inset 0 0 0 2px #d9b16c'},{boxShadow:'none'}],400);
 if(screen==='setup'&&prev?.jobPick!==next.jobPick)dsAnimate(app.querySelector('.tile.selected'),[{boxShadow:'inset 0 0 0 2px #d9b16c'},{boxShadow:'none'}],400);
 if(screen==='archive'&&(fresh||prev?.archiveFilter!==next.archiveFilter))dsAll('.archive button.open',[{opacity:.5,transform:'translateY(3px)'},{opacity:1,transform:'translateY(0)'}],250);
 if(resultPopup&&screen==='game'){dsAnimate(app.querySelector('.result-modal'),[{opacity:0,transform:'translateY(8px) scale(.985)'},{opacity:1,transform:'translateY(0) scale(1)'}],260);dsAnimate(app.querySelector('.result-art img'),[{opacity:.75},{opacity:1}],380);dsAll('.result-summary .res',[{opacity:.5,transform:'translateY(4px)'},{opacity:1,transform:'translateY(0)'}],220,6);}
 if(screen==='end'&&fresh){dsAnimate(app.querySelector('.endgrade'),[{opacity:0,transform:'scale(.88)'},{opacity:1,transform:'scale(1)'}],650);dsAll('.endwrap .res',[{opacity:.6},{opacity:1}],400);}
}
const originalRender=render;render=function(y=window.scrollY){const next=dsSnapshot();originalRender(y);dsDecorate(motionPrev,next);motionPrev=next;};
const originalToast=toast;toast=function(t){originalToast(t);dsAnimate(document.querySelector('.toast'),[{opacity:0,transform:'translate(-50%,6px)'},{opacity:1,transform:'translate(-50%,0)'}],220)};
const originalSettingsView=settingsView;settingsView=function(){return originalSettingsView().replace('<div class="choices">','<div class="choices"><button class="choice" onclick="toggleMotion()">화면 모션 · '+(motionEnabled?'켜짐':'꺼짐')+'<span class="arrow">›</span></button>')};
reducedMotion.addEventListener?.('change',()=>render());
render();
</script></body></html>
