function night(s){if(s.phase!=='night')return false;let ch=[];let record=s.rations?.day===s.day?s.rations:{food:0,water:0};let missedFood=!record.food,missedWater=!record.water;if(flag(s,'purifier')){s.W++;ch.push('정수기 · 물 +1')}if(flag(s,'garden')&&s.day%3===0){s.F+=3;ch.push('텃밭 · 식량 +3')}for(let [k,d,c] of [['E',12,'hunger'],['Q',18,'thirst']]){let before=s[k];s[k]=clamp(s[k]-d);if(before!==s[k])ch.push(STATN[k]+' -'+(before-s[k]));let hungry=k==='E',status=hungry?'허기':'갈증';if(s[k]<=40){let fatigue=hungry?5:8,old=s.P;s.P=clamp(s.P+fatigue);if(s.P>old)ch.push(status+' · 피로도 +'+(s.P-old));}if(s[k]<=20){let damage=s[k]===0?(hungry?8:15):(hungry?4:8),actual=Math.min(s.H,damage);s.H=clamp(s.H-damage);s.stats.damage+=actual;ch.push(status+' · 체력 -'+actual);if(die(s,c)){note(s,'마지막 밤',hungry?'굶주림으로 더 이상 버틸 수 없었다.':'탈수로 더 이상 버틸 수 없었다.',ch);return true}}}s.P=clamp(s.P+5);if(s.P>=90){s.H=clamp(s.H-4);ch.push('극심한 피로 · 체력 -4')}if(s.I>=50){s.I=clamp(s.I+2);ch.push('감염 악화 +2')}if(s.E<=20||s.Q<=20){let old=s.S;s.S=clamp(s.S-2);if(old>s.S)ch.push('영양·수분 부족 · 정신력 -'+(old-s.S))}if(s.day>=12&&s.day%7===0&&rnd(s)<.3){let damage=Math.max(1,Math.round((8+s.day/10)*(1-Math.max(0,s.L-2)*.1)));s.H=clamp(s.H-damage);ch.push('야간 습격 · 체력 -'+damage);if(die(s,'raid')){note(s,'야간 습격','거점이 무너졌다.',ch);return true}}if(die(s)){note(s,'하루의 끝','더 이상 이동할 수 없다.',ch);return true}let warnings=[];if(missedFood)warnings.push('어제 식사를 하지 않았다.');if(missedWater)warnings.push('어제 물을 마시지 않았다.');if(s.E<=40)warnings.push(s.E<=20?'극심한 허기 상태다. 체력과 정신력이 저하될 수 있다.':'허기로 피로가 증가하고 탐색 성공률이 떨어진다.');if(s.Q<=40)warnings.push(s.Q<=20?'심각한 갈증 상태다. 탈수로 생명이 위험해질 수 있다.':'갈증으로 피로가 증가하고 탐색 성공률이 떨어진다.');let warn=warnings.length>0;note(s,warn?(s.E<=20||s.Q<=20?'생존 위험 · 긴급 경고':'생존 경고 · 영양 및 수분 관리'):'하루의 끝',warn?warnings.join(' ')+' 식량과 물은 자동으로 사용되지 않았다.':'밤이 지나고 새로운 날이 밝았다. 식량과 물은 자동으로 사용되지 않았다.',ch);if(warn){s.last.warning=true;s.last.art=missedWater||s.Q<=40?'resW':'resF';s.last.nextDay=s.day+1;}s.day++;s.rations={day:s.day,food:0,water:0};s.phase='main';s.freeUsed=false;if(s.randomStory)selectEvent(s);return true}
function useItem(s,id){let food=id>=14&&id<28,water=id===35,manual=food||water;if(!s.items[id]||s.ending||(!manual&&s.phase!=='free')||(food&&s.E>=100)||(water&&s.Q>=100))return false;let code;if(food)code='E25';else if(id>=28&&id<40)code=id===39?'I-12':water?'Q25':'H12';else return false;s.items[id]--;let ch=apply(s,code,'아이템 사용');note(s,ITEMS[id]+' 사용','가방의 물품을 사용했다.',ch);s.last.art='item'+id;if(manual)rationRecord(s,food?'food':'water');if(!manual){s.freeUsed=true;afterFree(s)}return true}
</script><script>Object.assign(ART,{"resF": "data:image/png;base64,", "resW": "data:image/png;base64,", "resA": "data:image/png;base64,", "resD": "data:image/png;base64,", "resM": "data:image/png;base64,"});
Object.assign(ART,{"resH": "data:image/png;base64,", "resE": "data:image/png;base64,", "resQ": "data:image/png;base64,", "resI": "data:image/png;base64,", "resS": "data:image/png;base64,", "resP": "data:image/png;base64,"});

const STORE='dead-signal-v1-save';const ARCH='dead-signal-v1-archive';let state=null,screen='title',tab='survival',jobPick=0,diffPick=1,playerName='생존자',selectedItem=null,archiveFilter='end',toastTimer=null,storageOk=true;
const app=document.getElementById('app');const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const pad=(n,w=3)=>String(n).padStart(w,'0');const img=(key,cls='')=>`<img class="${cls}" data-art="${esc(key)}" src="${ART[key]||ART.scene0}" alt="" draggable="false">`;const icon=(k)=>`<svg viewBox="0 0 24 24" aria-hidden="true">${({survival:'<path d="M3 11l9-8 9 8v10h-6v-6H9v6H3z"/>',explore:'<path d="M3 5l6-2 6 2 6-2v16l-6 2-6-2-6 2zM9 3v16M15 5v16"/>',bag:'<rect x="5" y="7" width="14" height="14" rx="2"/><path d="M9 7V4h6v3M5 13h14M9 13v4h6v-4"/>',party:'<circle cx="9" cy="7" r="3"/><circle cx="18" cy="9" r="2.5"/><path d="M2 21v-3a7 7 0 0114 0v3zM17 15a5 5 0 015 5"/>',base:'<path d="M3 21V10l9-7 9 7v11zM7 21v-8h10v8M3 10h18"/>',journal:'<path d="M4 3h7v17H4zM13 3h7v17h-7zM6 7h3M6 11h3M15 7h3M15 11h3"/>'})[k]||''}</svg>`;
function getArchive(){try{return JSON.parse(localStorage.getItem(ARCH))||{ends:{},items:[],npc:[],z:[],secrets:[]}}catch{return {ends:{},items:[],npc:[],z:[],secrets:[]}}}
function save(){if(!state)return;try{localStorage.setItem(STORE,JSON.stringify(state));let a=getArchive();for(let [k,arr] of [['items',state.seenItems],['npc',state.seenNPC],['z',state.seenZ],['secrets',state.secrets]])a[k]=[...new Set([...(a[k]||[]),...arr])];if(state.ending)a.ends[state.ending]={day:state.day,job:state.job,date:Date.now()};localStorage.setItem(ARCH,JSON.stringify(a));storageOk=true}catch{storageOk=false}}
function saved(){try{let s=JSON.parse(localStorage.getItem(STORE));return s&&s.v===1&&s.day>=1&&s.day<=100?s:null}catch{return null}}
function toast(t){document.querySelector('.toast')?.remove();let el=document.createElement('div');el.className='toast';el.textContent=t;document.body.append(el);clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.remove(),2300)}
// Retain each gameplay tab's reading position, including after a full DOM refresh.
const tabScroll=Object.create(null);
function rememberTabScroll(){if(screen==='game')tabScroll[tab]=window.scrollY;}
function clearTabScroll(){for(const k of Object.keys(tabScroll))delete tabScroll[k];}
function show(s){const previous=screen;rememberTabScroll();screen=s;render(s==='game'&&previous==='archive'?(tabScroll[tab]||0):previous===s?window.scrollY:0)}
function go(t){if(t===tab){render();return}rememberTabScroll();tab=t;render(tabScroll[t]||0)}
function act(fn,keepTab=false){if(!state||resultPopup)return;const previousTab=tab,y=window.scrollY;rememberTabScroll();let ok=fn();if(ok){save();resultPopup=makeResultPopup(previousTab);if(state.ending){show('end');return}tab=keepTab?previousTab:'survival';render(tab===previousTab?y:(tabScroll.survival||0))}else toast('현재 선택할 수 없는 행동입니다.');}
function begin(){if(saved()&&!saved().ending&&!confirm('이전 생존 기록을 덮어쓰고 새로 시작할까요?'))return;state=create(jobPick,diffPick,playerName.trim().slice(0,20)||'생존자',crypto.getRandomValues(new Uint32Array(1))[0]);clearTabScroll();tab='survival';save();show('game')}
function resume(){state=saved();if(!state){toast('저장된 게임이 없습니다.');return}clearTabScroll();tab='survival';show(state.ending?'end':'game')}
function chips(ch){return `<div class="chips">${(ch||[]).map(x=>`<span class="chip ${/ -\d/.test(x)?'neg':''}">${esc(x)}</span>`).join('')}</div>`}
function resourceTile(k,v,label=STATN[k]){return `<div class="res resource-tile" data-resource="${k}"><div class="meter-inline">${img(k==='V'?'item74':'res'+k,'resource-icon')}<span>${esc(label)}</span><b>${v}</b></div></div>`}
function foodControls(s){let r=s.rations?.day===s.day?s.rations:{food:0,water:0};return `<div class="ration-actions"><button class="plain ration" ${s.F<1||s.E>=100?'disabled':''} onclick="doFree('eat')">${img('resF','ration-icon')}<span>식사 <small>+25</small><small class="ration-mark">${r.food?'오늘 '+r.food+'회':'오늘 미섭취'}</small></span></button><button class="plain ration" ${s.W<1||s.Q>=100?'disabled':''} onclick="doFree('drink')">${img('resW','ration-icon')}<span>물 마시기 <small>+35</small><small class="ration-mark">${r.water?'오늘 '+r.water+'회':'오늘 미섭취'}</small></span></button></div>`}
function nutritionStatus(s){let text=[];if(s.E<=40)text.push(s.E<=20?'극심한 허기':'허기');if(s.Q<=40)text.push(s.Q<=20?'극심한 갈증':'갈증');return text.length?`<div class="nutrition-warning">${text.join(' · ')} — 탐색 성공률 저하${s.E<=20||s.Q<=20?' · 야간 체력 감소':''}</div>`:''}
function hud(s){return `<div class="hud">${[['H','체력','#bc6256'],['E','포만','#c2a469'],['Q','수분','#6a9bbc'],['S','정신','#aa95c1'],['P','피로','#c2a469'],['I','감염','#9eac70']].map(([k,n,c])=>`<div class="stat"><div class="meter-inline">${img('res'+k,'resource-icon')}<span>${STATN[k]}</span><strong>${s[k]}</strong></div><div class="track"><i style="width:${s[k]}%;--c:${c}"></i></div></div>`).join('')}</div><div class="resources">${['F','W','A','D','M'].map(k=>resourceTile(k,s[k])).join('')}</div>${foodControls(s)}${nutritionStatus(s)}`}
function hero(key,tag){return `<div class="hero">${img(key)}${tag?`<div class="hero-tag">${esc(tag)}</div>`:''}</div>`}
function choice(o,i,fn){let locked=check(state,o.code,o.label);return `<button class="choice" ${locked?'disabled':''} onclick="${fn}(${i})"><span class="index">${pad(i+1,2)}</span><span>${esc(o.label)}${locked?`<span class="lock">${esc(locked)}</span>`:''}</span><span class="arrow">›</span></button>`}
function last(){let l=state.last;return l?`<div class="notice"><div class="label">직전 행동 · ${esc(l.title)}</div><p>${esc(l.text)}</p>${chips(l.changes)}</div>`:''}
function survival(){let s=state,e=eventFor(s),h=`${hero(e.art,`${s.day===1&&s.randomStory?s.startLocation:`CH. ${pad(Math.ceil(s.day/10),2)} / ${CHAPTERS[Math.floor((s.day-1)/10)]}`}`)}<div class="event-head"><span class="day">DAY ${pad(s.day)}</span><span class="label">${s.phase==='main'?'주요 사건':s.phase==='free'?'오후 · 자유 행동':s.phase==='secret'?'발견 · 돌발 사건':s.phase==='npc'?'조우 · 생존자':'야간 · 하루 결산'}</span></div>`;
if(s.phase==='main')return h+`<h1>${esc(e.title)}</h1><p class="bodycopy">${esc(e.description)}</p><div class="choices">${e.options.map((o,i)=>choice(o,i,'chooseMain')).join('')}</div><p class="footerhint">선택은 되돌릴 수 없습니다. 일부 결과는 훗날 돌아옵니다.</p>`;
if(s.phase==='free')return h+`<h1>남은 시간</h1>${last()}<p class="bodycopy">오늘 한 번 더 행동할 수 있다. 탐색과 휴식 중 무엇을 선택할까?</p><div class="choices"><button class="choice" onclick="go('explore')"><span class="index">01</span>지역 탐색 및 물자 확보<span class="arrow">›</span></button><button class="choice" onclick="doFree('rest')"><span class="index">02</span>거점에서 휴식 · 피로 회복<span class="arrow">›</span></button><button class="choice" ${s.D<1?'disabled':''} onclick="doFree('heal')"><span class="index">03</span>치료 · 약품 1개 사용<span class="arrow">›</span></button><button class="choice" onclick="go('bag')"><span class="index">04</span>가방 확인 · 식사 / 수분 보충<span class="arrow">›</span></button><button class="choice" onclick="go('party')"><span class="index">05</span>동료와 대화<span class="arrow">›</span></button><button class="choice" onclick="go('base')"><span class="index">06</span>대피소 강화<span class="arrow">›</span></button><button class="plain" onclick="doFree('skip')">추가 행동 없이 진행</button></div>`;
if(s.phase==='secret'){let q=SECRETS[s.secret];return h+`<h1>${esc(q.title)}</h1>${last()}<p class="bodycopy">이전의 행동과 현재 상황이 새로운 사건을 불러왔다. 지금의 선택 또한 기록된다.</p><div class="choices">${q.options.map((o,i)=>choice(o,i,'chooseSecret')).join('')}<button class="plain" onclick="skipSecret()">관여하지 않고 지나간다</button></div>`}
if(s.phase==='npc'){let id=s.action.id;return h+`<div class="party-row">${img('npc'+id)}<div><h2>${PEOPLE[id]}</h2><span class="small">${ROLES[id]} · ${SKILLS[id]}</span></div></div>${last()}<p class="bodycopy">생존자가 함께 가기를 요청한다. 식량 1개를 나누면 동료가 될 수 있다.</p><div class="choices"><button class="choice" ${s.F<1?'disabled':''} onclick="act(()=>npcChoice(state,true))">식량을 나누고 받아들인다</button><button class="choice" onclick="act(()=>npcChoice(state,false))">서로의 길을 간다</button></div>`}
return h+`<h1>오늘의 마지막 밤</h1>${last()}<p class="bodycopy">식량과 물은 자동 소비되지 않는다. 먹지 않고 밤을 넘길 수도 있다. 다음 날 포만감 -12, 수분 -18. 부족하면 피로와 체력에 불이익이 생긴다.</p><div class="notice">현재 포만감 ${s.E} → ${clamp(s.E-12)} · 수분 ${s.Q} → ${clamp(s.Q-18)}<br><span class="small">아래 버튼으로 직접 섭취하거나 그대로 다음 날로 진행할 수 있다. 오늘 식사 또는 물 섭취를 하지 않았다면 다음 날 경고가 표시된다.</span></div>${foodControls(s)}<button class="primary" style="width:100%" onclick="act(()=>night(state))">DAY ${pad(s.day+1)}로 이동　›</button>`}
function chooseMain(i){act(()=>mainChoose(state,i))}function chooseSecret(i){act(()=>secretChoose(state,i))}function doFree(k,arg){act(()=>free(state,k,arg),k==='eat'||k==='drink')}function skipSecret(){act(()=>{if(state.phase!=='secret')return false;state.secrets.push(state.secret);note(state,SECRETS[state.secret].title,'관여하지 않고 지나갔다.');state.secret=-1;state.phase='night';return true})}
function exploreView(){let s=state;return `<div class="subhead"><h2>탐색 지역</h2><span class="label">HAEWON CITY / 20</span></div>${s.phase!=='free'?'<div class="notice">탐색은 주요 사건을 완료한 뒤 하루 한 번 가능합니다.</div>':s.H<=20||s.P>=80?'<div class="notice danger">체력 또는 피로도 때문에 탐색할 수 없습니다. 휴식이 필요합니다.</div>':'<p class="bodycopy">지역을 선택하면 물자를 발견할 수 있지만 피해나 감염이 발생할 수 있습니다. 반복 방문 시 물자가 줄어듭니다.</p>'}<div class="grid">${LOCS.map((n,i)=>{let lock=s.day<UNLOCK[i],off=lock||s.phase!=='free'||s.H<=20||s.P>=80;return `<button class="tile" ${off?'disabled':''} onclick="act(()=>explore(state,${i}))">${img('loc'+i)}<div class="tilebody"><b>${pad(i+1,2)} ${n}</b><span class="small">${lock?'DAY '+pad(UNLOCK[i])+' 해금':'위험 '+['','낮음','보통','높음','매우 높음','극심'][RISK[i]]+' · 방문 '+(s.visited[i]||0)+'회'}</span><span class="small">${LOOT[i].split(' ').map(k=>STATN[k]).join(' / ')}</span></div></button>`}).join('')}</div>`}
function bagView(){let s=state;let owned=ITEMS.map((n,i)=>({n,i,q:s.items[i]||0,f:ITEMFLAGS[i]&&flag(s,ITEMFLAGS[i])})).filter(x=>x.q||x.f);let item=selectedItem===null?null:owned.find(x=>x.i===selectedItem);return `<div class="subhead"><h2>가방</h2><span class="label">INVENTORY</span></div><div class="resources">${RES.map(k=>resourceTile(k,s[k])).join('')}</div>${foodControls(s)}<p class="footerhint">식사와 물 마시기는 자유 행동을 소비하지 않습니다. 각각 자원 1개 사용.</p><h3 class="section">착용 장비</h3><div class="split"><div class="notice">무기 · ${s.equipped.weapon===null?'없음':ITEMS[s.equipped.weapon]}</div><div class="notice">방어구 · ${s.equipped.armor===null?'없음':ITEMS[s.equipped.armor]}</div></div><h3 class="section">보유 아이템 (${owned.length}종)</h3><div class="inventory">${owned.map(x=>`<button class="slot ${selectedItem===x.i?'selected':''}" onclick="selectedItem=${x.i};render()">${img('item'+x.i)}${esc(x.n)}<br><span class="small">${x.f?'보유':('×'+x.q)}</span></button>`).join('')}</div>${item?`<div class="notice"><b>${esc(item.n)}</b><p>${item.i<14||item.i>=42&&item.i<54?'장착하면 일부 전투 피해를 줄일 수 있습니다.':item.i>=14&&item.i<40?(item.i<28||item.i===35?'직접 섭취해 상태를 회복합니다. 자유 행동을 사용하지 않습니다.':'사용하면 생존 상태를 회복합니다. 하루 자유 행동을 사용합니다.'):'탐색 또는 스토리 조건에 사용되는 물품입니다.'}</p>${item.q&&(item.i<14||item.i>=42&&item.i<54)?`<button class="plain" onclick="equip(${item.i})">장착</button>`:item.q&&item.i>=14&&item.i<40?`<button class="plain" ${(item.i<28?s.E>=100:item.i===35?s.Q>=100:s.phase!=='free')?'disabled':''} onclick="act(()=>useItem(state,${item.i}),${item.i<28||item.i===35})">사용</button>`:''}</div>`:''}<h3 class="section">스토리 기록 및 시설</h3><div class="chips">${Object.keys(s.flags).filter(k=>s.flags[k]&&FLAGN[k]).map(k=>`<span class="chip">${esc(FLAGN[k])}</span>`).join('')||'<span class="small">아직 기록이 없습니다.</span>'}</div>`}
function equip(id){if(!state.items[id])return;state.equipped[id<14?'weapon':'armor']=id;note(state,ITEMS[id]+' 장착','장비를 교체했다.',[id<14?'무기 장착':'방어구 장착']);resultPopup=makeResultPopup('equip');save();render(window.scrollY)}
